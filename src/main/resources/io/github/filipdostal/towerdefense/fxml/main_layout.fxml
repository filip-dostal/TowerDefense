<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainContainer" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.filipdostal.towerdefense.GameController">

    <!-- The Right Sidebar (UI) -->
    <right>
        <VBox prefWidth="200" spacing="15" style="-fx-background-color: #333333; -fx-padding: 20;">
            <Label fx:id="moneyLabel" style="-fx-font-size: 16px;" text="Money: $650" textFill="WHITE" />

            <!-- Calls buyDartMonkey() in the controller when clicked -->
            <Button maxWidth="Infinity" onAction="#buyTower" text="Tower ($250)" />
        </VBox>
    </right>

</BorderPane>
